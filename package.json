    "@red-cup-engineering/crucible-561-group": "0.1.0",
    "@red-cup-engineering/durante": "0.1.0",
    "@red-cup-engineering/gambling-trainer-561-group": "0.1.0",
    "@red-cup-engineering/onestone-561-group": "0.1.0",
    "@red-cup-engineering/parlor-service-561-group": "0.1.0",
